# Demo mode (no Firebase required) — set to "true" for local/demo
VITE_USE_DEMO_DATA=true

# Firebase (required when VITE_USE_DEMO_DATA is not true)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary (optional — paste image URLs if not set)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Business contact (optional overrides)
VITE_WHATSAPP_NUMBER=254758342670
VITE_PHONE_NUMBER=0758342670
