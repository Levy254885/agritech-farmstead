rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null;
    }

    match /products/{id} {
      allow read: if resource == null || resource.data.available == true || isAdmin();
      allow list: if true;
      allow write: if isAdmin();
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{id} {
      allow create: if true;
      allow read, update: if isAdmin();
    }

    match /siteContent/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blogPosts/{id} {
      allow read: if resource == null || resource.data.published == true || isAdmin();
      allow list: if true;
      allow write: if isAdmin();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /media/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{id} {
      allow read, write: if isAdmin();
    }
  }
}
